}

Ref fk_table_pretacao_servicos_id_table_proposta {
	table_pretacao_servicos.id < table_proposta.id_prestacao [ delete: no action, update: no action ]
}

Ref fk_table_orcamento_id_table_pretacao_servicos {
	table_orcamento.id < table_pretacao_servicos.id_orcamento [ delete: no action, update: no action ]
}